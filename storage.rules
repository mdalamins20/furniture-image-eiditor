rules_version = '2';
// Firebase Storage rules for the Furniture Image Editor.
// Logos and uploads belong to the signed-in owner only; public reads are
// allowed only for files under /public/ (none are written by the app).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
